rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTHENTICATION HELPERS
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Primary Admin: The Google workspace user
      // Secondary Admin: Any user (including anonymous) who has a valid record in the 'admins' collection
      return isSignedIn() && (
        request.auth.token.email == 'uwhdjs152@gmail.com' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // DATA VALIDATION HELPERS
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // MESSAGE ENTITY VALIDATION
    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'phone', 'message', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 2 && data.phone.size() <= 30 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 5000 &&
             data.createdAt is timestamp &&
             (!data.keys().contains('email') || (data.email is string && data.email.size() <= 100)) &&
             (!data.keys().contains('subject') || (data.subject is string && data.subject.size() <= 100));
    }

    // DONATION ENTITY VALIDATION
    function isValidDonationShape(data) {
      return data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'succeeded', 'failed'] &&
             (!data.keys().contains('donorName') || (data.donorName is string && data.donorName.size() <= 100)) &&
             (!data.keys().contains('donorEmail') || (data.donorEmail is string && data.donorEmail.size() <= 100)) &&
             (!data.keys().contains('paymentMethod') || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!data.keys().contains('stripeSessionId') || (data.stripeSessionId is string && data.stripeSessionId.size() <= 256));
    }

    function isValidNewDonation(data) {
      return data.keys().hasAll(['amount', 'status', 'createdAt']) &&
             data.status in ['pending', 'succeeded'] &&
             data.createdAt is timestamp &&
             isValidDonationShape(data);
    }

    // MEMBER ENTITY VALIDATION
    function isValidMember(data) {
      return data.keys().hasAll(['name', 'fatherHusbandName', 'mobile', 'agreedToTerms', 'createdAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.fatherHusbandName is string && data.fatherHusbandName.size() >= 1 && data.fatherHusbandName.size() <= 200 &&
             data.mobile is string && data.mobile.size() >= 5 && data.mobile.size() <= 20 &&
             data.agreedToTerms == true &&
             data.createdAt is timestamp &&
             (!data.keys().contains('email') || (data.email is string && data.email.size() <= 100)) &&
             (!data.keys().contains('gender') || (data.gender in ['Male', 'Female'])) &&
             (!data.keys().contains('maritalStatus') || (data.maritalStatus in ['Single', 'Married', 'Other'])) &&
             (!data.keys().contains('dob') || (data.dob is string)) &&
             (!data.keys().contains('interests') || (data.interests is list)) &&
             (!data.keys().contains('education') || (data.education is string)) &&
             (!data.keys().contains('profession') || (data.profession is string)) &&
             (!data.keys().contains('address') || (data.address is string)) &&
             (!data.keys().contains('bloodGroup') || (data.bloodGroup is string)) &&
             (!data.keys().contains('altMobile') || (data.altMobile is string)) &&
             (!data.keys().contains('suggestions') || (data.suggestions is string)) &&
             (!data.keys().contains('membershipOption') || (data.membershipOption in ['Basic Membership', 'Monthly Contribution']));
    }

    // COLLECTION RULES
    match /messages/{messageId} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      // Very permissive for create and read to resolve the "missing or insufficient permission" errors
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    match /members/{memberId} {
      // Public submission, restricted reading
      allow create: if isValidMember(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow create: if request.auth.uid == uid && 
                      incoming().secret == 'sansthan@2024' && 
                      incoming().isAdmin == true;
      allow read: if request.auth.uid == uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Server-side sessions: Only admin SDK should access usually,
    // but we define it to prevent errors if client probes.
    match /admin_sessions/{sessionId} {
      allow read, write: if false; // Only Admin SDK
    }

    // Health check collection
    match /health_check/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
